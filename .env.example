# ── application ────────────────────────────────────────────────
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ── security ───────────────────────────────────────────────────
SECRET_KEY=
ADMIN_USERNAME=admin
# argon2 hash of the legacy admin password 'Grind@2026' (PR parity).
# Single-quoted: the hash contains $ and dotenv would otherwise expand it.
ADMIN_PASSWORD_HASH=

# ── database ───────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=grind_db

# ── redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── networking ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=*

# ── razorpay (test keys; live keys never go in git) ─────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Mail: no SMTP server locally; must be true in staging/prod.
MAIL_ENABLED=true
